# ==========================================
# CamGO Platform - Root .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
.env.local
.env.*.local
!.env.example
!.env.*.example

# Node / Frontend dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production build outputs
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
.next/
**/out/

# PHP / Composer / Laravel
vendor/
**/vendor/
*.log
logs/
**/logs/
backend/storage/*.key
backend/storage/pail/
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore
backend/public/storage
backend/public/hot
backend/public/build
backend/.phpunit.result.cache
_ide_helper.php
Homestead.json
Homestead.yaml

# Supabase Local
supabase/.temp/
**/supabase/.temp/

# IDE, OS, & System files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.phpactor.json

# Exclude markdown files per user instruction
*.md
**/*.md

# Vercel Project Metadata
.vercel/

# Performance docs and temporary copies
docs/perf/
**/assets copy/

