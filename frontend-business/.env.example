# CamGO Business Frontend Environment Variables

# Backend API URL (points to production backend in staging/prod)
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=/api/v1

# Storage URL for uploaded media
VITE_STORAGE_URL=http://localhost:8000

# Cross-portal links
VITE_TRAVEL_BASE_URL=http://localhost:5173
VITE_PUBLIC_BUSINESS_URL=http://localhost:5175
VITE_ADMIN_BASE_URL=http://localhost:5176
